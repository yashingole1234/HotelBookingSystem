@model IEnumerable<HotelBookingSystem.Models.Room>

@{
    ViewData["Title"] = "Room Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="text-warning text-uppercase fw-bold" style="letter-spacing: 0.12em; font-size: 0.85rem;">Administration</span>
            <h1 class="display-6 fw-bold m-0 text-dark">Hotel Room Inventory</h1>
            <p class="text-muted small m-0">Total of @Model.Count() rooms managed in the system</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-grid"></i> Guest Catalog View
            </a>
            <a asp-action="Create" class="btn btn-luxe-gold">
                <i class="bi bi-plus-circle"></i> Add New Room
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-luxe align-middle mb-0">
                <thead>
                    <tr>
                        <th>Room</th>
                        <th>Category</th>
                        <th>Floor</th>
                        <th>Capacity</th>
                        <th>Nightly Rate</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(room.ImageUrl) ? "/images/rooms/deluxe.jpg" : room.ImageUrl)" 
                                         alt="Room @room.RoomNumber" class="rounded-3" style="width: 50px; height: 50px; object-fit: cover;" 
                                         onerror="this.onerror=null; this.src='/images/rooms/deluxe.jpg';" />
                                    <div>
                                        <div class="fw-bold">Room @room.RoomNumber</div>
                                        <small class="text-muted">ID: #@room.RoomId</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@room.RoomType?.TypeName</span>
                            </td>
                            <td>Floor @room.FloorNumber</td>
                            <td>@(room.RoomType?.Capacity ?? 2) Guests</td>
                            <td class="fw-bold text-dark">₹@(room.RoomType?.PricePerNight.ToString("N0") ?? "0")</td>
                            <td>
                                @if (room.Status == "Available")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                        <i class="bi bi-check-circle me-1"></i> Available
                                    </span>
                                }
                                else if (room.Status == "Booked")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 rounded-pill">
                                        <i class="bi bi-person-fill me-1"></i> Occupied
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill">
                                        <i class="bi bi-tools me-1"></i> Maintenance
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@room.RoomId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@room.RoomId" class="btn btn-outline-primary" title="Edit Room">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@room.RoomId" class="btn btn-outline-danger" title="Delete Room">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
