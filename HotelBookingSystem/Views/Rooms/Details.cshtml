@model HotelBookingSystem.Models.Room

@{
    ViewData["Title"] = $"Room {Model.RoomNumber} - {Model.RoomType?.TypeName}";
}

<div class="container py-4">
    <!-- Breadcrumb & Back -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index">Rooms</a></li>
                <li class="breadcrumb-item active" aria-current="page">Room @Model.RoomNumber</li>
            </ol>
        </nav>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Rooms
        </a>
    </div>

    <div class="row g-4">
        <!-- Room Media & Details -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="position-relative" style="height: 420px; background: #0c182c;">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/rooms/deluxe.jpg" : Model.ImageUrl)" 
                         alt="Room @Model.RoomNumber" class="w-100 h-100 object-fit-cover" 
                         onerror="this.onerror=null; this.src='/images/rooms/deluxe.jpg';" />

                    @if (Model.Status == "Available")
                    {
                        <div class="room-badge-status badge-avail">
                            <span class="status-indicator-dot"></span> Available for Booking
                        </div>
                    }
                    else if (Model.Status == "Booked")
                    {
                        <div class="room-badge-status badge-booked">
                            <span class="status-indicator-dot"></span> Currently Booked
                        </div>
                    }
                    else
                    {
                        <div class="room-badge-status badge-maint">
                            <span class="status-indicator-dot"></span> Maintenance
                        </div>
                    }
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                        <span class="text-warning text-uppercase fw-bold" style="letter-spacing: 0.12em; font-size: 0.85rem;">
                            Floor @Model.FloorNumber • @Model.RoomType?.TypeName
                        </span>
                        <div class="fs-4 fw-bold text-dark">
                            ₹@(Model.RoomType?.PricePerNight.ToString("N0") ?? "0") <span class="fs-6 text-muted fw-normal">/ night</span>
                        </div>
                    </div>

                    <h1 class="display-6 fw-bold mb-3">Room @Model.RoomNumber</h1>

                    <p class="lead text-muted mb-4">
                        @(string.IsNullOrEmpty(Model.Description) ? Model.RoomType?.Description : Model.Description)
                    </p>

                    <h5 class="fw-bold text-dark mb-3">Room Specifications</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6 col-md-3">
                            <div class="p-3 bg-light rounded-3 text-center">
                                <i class="bi bi-people fs-4 text-warning"></i>
                                <div class="small text-muted mt-1">Capacity</div>
                                <div class="fw-bold">@(Model.RoomType?.Capacity ?? 2) Guests</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="p-3 bg-light rounded-3 text-center">
                                <i class="bi bi-layers fs-4 text-primary"></i>
                                <div class="small text-muted mt-1">Floor</div>
                                <div class="fw-bold">Floor @Model.FloorNumber</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="p-3 bg-light rounded-3 text-center">
                                <i class="bi bi-check-circle fs-4 text-success"></i>
                                <div class="small text-muted mt-1">Status</div>
                                <div class="fw-bold">@Model.Status</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="p-3 bg-light rounded-3 text-center">
                                <i class="bi bi-award fs-4 text-info"></i>
                                <div class="small text-muted mt-1">Rating</div>
                                <div class="fw-bold">5-Star Luxe</div>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark mb-3">Complimentary In-Room Amenities</h5>
                    <div class="row g-2 text-muted">
                        <div class="col-md-6"><i class="bi bi-wifi text-warning me-2"></i>High-Speed Fiber Wi-Fi</div>
                        <div class="col-md-6"><i class="bi bi-snow text-warning me-2"></i>Climate Control Air Conditioning</div>
                        <div class="col-md-6"><i class="bi bi-cup-hot text-warning me-2"></i>Nespresso Coffee Machine & Gourmet Teas</div>
                        <div class="col-md-6"><i class="bi bi-tv text-warning me-2"></i>55" 4K Smart Ultra-HD TV with Streaming</div>
                        <div class="col-md-6"><i class="bi bi-droplet text-warning me-2"></i>Marble Ensuite with Rain Shower</div>
                        <div class="col-md-6"><i class="bi bi-safe text-warning me-2"></i>Electronic Digital In-Room Safe</div>
                        <div class="col-md-6"><i class="bi bi-bell text-warning me-2"></i>24-Hour Room Service & Turndown</div>
                        <div class="col-md-6"><i class="bi bi-soundwave text-warning me-2"></i>Acoustic Soundproofing Glass</div>
                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                        <hr class="my-4" />
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.RoomId" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Edit Room
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.RoomId" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Delete Room
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Booking Sidebar Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top bg-white" style="top: 100px;">
                <h4 class="fw-bold mb-3">Reserve This Room</h4>
                <div class="mb-3">
                    <span class="text-muted">Nightly Rate:</span>
                    <h3 class="fw-bold text-warning d-inline-block ms-2">₹@(Model.RoomType?.PricePerNight.ToString("N0") ?? "0")</h3>
                    <small class="text-muted">/ night</small>
                </div>

                @if (Model.Status == "Available")
                {
                    <p class="text-muted small">
                        Select your check-in and check-out dates to confirm availability and proceed to instant reservation.
                    </p>

                    <a asp-controller="Bookings" asp-action="Create" asp-route-roomId="@Model.RoomId" class="btn btn-luxe-gold w-100 py-3 mb-3">
                        <i class="bi bi-calendar-check me-1"></i> Proceed to Booking
                    </a>
                }
                else
                {
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-triangle me-1"></i> This room is currently unavailable for booking.
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        Explore Available Rooms
                    </a>
                }

                <hr />
                <div class="small text-muted">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <span>Best Rate Guarantee Direct Booking</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-clock-history text-primary fs-5"></i>
                        <span>Free Cancellation up to 24 hrs prior</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-credit-card text-info fs-5"></i>
                        <span>Pay online or at hotel check-in</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
