@model HotelBookingSystem.Models.Room

@{
    ViewData["Title"] = $"Edit Room {Model.RoomNumber}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="p-4 bg-light border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold m-0 text-dark">Edit Room @Model.RoomNumber</h4>
                        <small class="text-muted">Update room configuration, price category, or status</small>
                    </div>
                    <a asp-action="Manage" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Inventory
                    </a>
                </div>

                <div class="p-4 p-md-5">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="RoomId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="RoomNumber" class="form-label">Room Number *</label>
                                <input asp-for="RoomNumber" class="form-control" required />
                                <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="FloorNumber" class="form-label">Floor Number *</label>
                                <input asp-for="FloorNumber" class="form-control" type="number" min="1" max="50" required />
                                <span asp-validation-for="FloorNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="RoomTypeId" class="form-label">Room Category *</label>
                                <select asp-for="RoomTypeId" class="form-select" required>
                                    @if (ViewBag.RoomTypes != null)
                                    {
                                        foreach (var type in ViewBag.RoomTypes)
                                        {
                                            <option value="@type.RoomTypeId" selected="@(Model.RoomTypeId == type.RoomTypeId)">
                                                @type.TypeName - ₹@type.PricePerNight.ToString("N0") / night
                                            </option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="RoomTypeId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label">Status *</label>
                                <select asp-for="Status" class="form-select" required>
                                    <option value="Available" selected="@(Model.Status == "Available")">Available</option>
                                    <option value="Booked" selected="@(Model.Status == "Booked")">Booked / Occupied</option>
                                    <option value="Maintenance" selected="@(Model.Status == "Maintenance")">Under Maintenance</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="ImageUrl" class="form-label">Image URL</label>
                                <input asp-for="ImageUrl" class="form-control" />
                                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label">Room Description</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Manage" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-luxe-gold px-4">
                                <i class="bi bi-check-circle"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
