@model HotelBookingSystem.Models.Room

@{
    ViewData["Title"] = $"Delete Room {Model.RoomNumber}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="p-4 bg-danger text-white">
                    <h4 class="fw-bold m-0"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Room Deletion</h4>
                </div>

                <div class="p-4 p-md-5 text-center">
                    <div class="mb-3">
                        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/rooms/deluxe.jpg" : Model.ImageUrl)" 
                             alt="Room @Model.RoomNumber" class="rounded-4 shadow-sm" style="width: 140px; height: 100px; object-fit: cover;" 
                             onerror="this.onerror=null; this.src='/images/rooms/deluxe.jpg';" />
                    </div>

                    <h3 class="fw-bold text-dark">Room @Model.RoomNumber</h3>
                    <p class="text-muted">@Model.RoomType?.TypeName • Floor @Model.FloorNumber</p>
                    <p class="text-danger fw-semibold">
                        Are you sure you want to permanently delete this room? This action cannot be undone.
                    </p>

                    <form asp-action="Delete" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="RoomId" />
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-action="Manage" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash"></i> Permanently Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
