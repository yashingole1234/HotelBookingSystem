@model IEnumerable<HotelBookingSystem.Models.RoomType>

@{
    ViewData["Title"] = "Room Categories";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="text-warning text-uppercase fw-bold" style="letter-spacing: 0.12em; font-size: 0.85rem;">Administration</span>
            <h1 class="display-6 fw-bold m-0 text-dark">Room Categories & Pricing</h1>
            <p class="text-muted small m-0">Define room classes, pricing structures, and guest capacities</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
            <a asp-action="CreateRoomType" class="btn btn-luxe-gold">
                <i class="bi bi-plus-circle me-1"></i> Add Category
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-luxe align-middle mb-0">
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Max Capacity</th>
                        <th>Price / Night</th>
                        <th>Rooms Assigned</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rt in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark fs-6">@rt.TypeName</div>
                            </td>
                            <td>
                                <div class="text-muted small" style="max-width: 320px;">@rt.Description</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-people me-1"></i> @rt.Capacity Guests
                                </span>
                            </td>
                            <td>
                                <span class="fw-bold text-dark fs-6">₹@rt.PricePerNight.ToString("N0")</span>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1">
                                    @rt.Rooms.Count Room(s)
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="EditRoomType" asp-route-id="@rt.RoomTypeId" class="btn btn-outline-primary" title="Edit Category">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (!rt.Rooms.Any())
                                    {
                                        <form asp-action="DeleteRoomType" asp-route-id="@rt.RoomTypeId" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete Category">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
