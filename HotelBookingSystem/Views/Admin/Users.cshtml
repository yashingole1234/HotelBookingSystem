@model IEnumerable<HotelBookingSystem.Models.User>

@{
    ViewData["Title"] = "User Accounts";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="text-warning text-uppercase fw-bold" style="letter-spacing: 0.12em; font-size: 0.85rem;">Administration</span>
            <h1 class="display-6 fw-bold m-0 text-dark">Registered Accounts</h1>
            <p class="text-muted small m-0">All registered guests and hotel staff members</p>
        </div>

        <a asp-action="Dashboard" class="btn btn-outline-secondary">
            <i class="bi bi-speedometer2 me-1"></i> Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-luxe align-middle mb-0">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>Full Name</th>
                        <th>Email Address</th>
                        <th>Phone Number</th>
                        <th>Role</th>
                        <th>Member Since</th>
                        <th>Total Bookings</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>#USR-@user.UserId.ToString("D4")</td>
                            <td>
                                <div class="fw-bold text-dark">@user.FullName</div>
                            </td>
                            <td>@user.Email</td>
                            <td>@(string.IsNullOrEmpty(user.Phone) ? "Not Provided" : user.Phone)</td>
                            <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1">
                                        <i class="bi bi-shield-lock me-1"></i> Administrator
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1">
                                        <i class="bi bi-person me-1"></i> Guest Member
                                    </span>
                                }
                            </td>
                            <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @user.Bookings.Count Reservation(s)
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
