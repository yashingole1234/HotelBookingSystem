@model HotelBookingSystem.ViewModels.BookingConfirmationViewModel

@{
    ViewData["Title"] = $"Reservation Confirmed - {Model.ReferenceNumber}";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Voucher Card -->
            <div class="voucher-card anim-fade-up">
                <!-- Header -->
                <div class="voucher-header">
                    <div class="hotel-seal">
                        <i class="bi bi-check-lg"></i>
                    </div>
                    <h2 class="display-6 fw-bold mb-1">Reservation Confirmed</h2>
                    <p class="text-white-50 m-0">Thank you for choosing The Grand Luxe Hotel & Suites</p>
                    <div class="mt-3">
                        <span class="badge bg-warning text-dark px-3 py-2 fs-6 fw-bold">
                            Booking Code: @Model.ReferenceNumber
                        </span>
                    </div>
                </div>

                <!-- Body -->
                <div class="voucher-body">
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <small class="text-muted text-uppercase fw-bold">Guest Details</small>
                            <h5 class="fw-bold text-dark mt-1">@Model.GuestName</h5>
                            <div class="text-muted small"><i class="bi bi-envelope me-1"></i> @Model.GuestEmail</div>
                            <div class="text-muted small"><i class="bi bi-telephone me-1"></i> @Model.GuestPhone</div>
                        </div>

                        <div class="col-md-6 text-md-end">
                            <small class="text-muted text-uppercase fw-bold">Reservation Date</small>
                            <div class="fw-semibold text-dark mt-1">@Model.BookingDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                            <div class="mt-1">
                                <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                    <i class="bi bi-check-circle-fill me-1"></i> Status: @Model.BookingStatus
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Stay Summary Box -->
                    <div class="card bg-light border-0 rounded-4 p-4 mb-4">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-3">
                                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/rooms/deluxe.jpg" : Model.ImageUrl)" 
                                     alt="Room @Model.RoomNumber" class="rounded-3 w-100 shadow-sm" style="height: 90px; object-fit: cover;" 
                                     onerror="this.onerror=null; this.src='/images/rooms/deluxe.jpg';" />
                            </div>
                            <div class="col-md-9">
                                <h4 class="fw-bold text-dark mb-1">Room @Model.RoomNumber — @Model.RoomTypeName</h4>
                                <div class="row g-2 mt-1 text-muted small">
                                    <div class="col-6 col-sm-4">
                                        <i class="bi bi-box-arrow-in-right text-warning me-1"></i> Check-In:
                                        <div class="fw-bold text-dark">@Model.CheckInDate.ToString("ddd, dd MMM yyyy")</div>
                                        <small>(From 2:00 PM)</small>
                                    </div>
                                    <div class="col-6 col-sm-4">
                                        <i class="bi bi-box-arrow-right text-warning me-1"></i> Check-Out:
                                        <div class="fw-bold text-dark">@Model.CheckOutDate.ToString("ddd, dd MMM yyyy")</div>
                                        <small>(Until 11:00 AM)</small>
                                    </div>
                                    <div class="col-12 col-sm-4">
                                        <i class="bi bi-people text-warning me-1"></i> Party:
                                        <div class="fw-bold text-dark">@Model.NumberOfGuests Guest(s)</div>
                                        <small>@((Model.CheckOutDate - Model.CheckInDate).Days) Night(s) Stay</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.SpecialRequest))
                    {
                        <div class="p-3 bg-white border rounded-3 mb-4">
                            <small class="text-muted fw-bold d-block text-uppercase">Special Requests Noted:</small>
                            <span class="text-dark">@Model.SpecialRequest</span>
                        </div>
                    }

                    <!-- Financial Summary -->
                    <div class="receipt-item">
                        <span class="text-muted">Rate Per Night:</span>
                        <span class="fw-semibold">₹@Model.PricePerNight.ToString("N0")</span>
                    </div>

                    <div class="receipt-item">
                        <span class="text-muted">Stay Duration:</span>
                        <span class="fw-semibold">@((Model.CheckOutDate - Model.CheckInDate).Days) Night(s)</span>
                    </div>

                    <div class="receipt-total">
                        <div>
                            <span class="fw-bold text-dark fs-5">Total Paid / Due:</span>
                            <div class="small text-muted">All hospitality taxes and fees included</div>
                        </div>
                        <div class="fs-3 fw-bold text-warning">
                            ₹@Model.TotalAmount.ToString("N0")
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-between align-items-center mt-5 flex-wrap gap-2 no-print">
                        <a asp-action="MyBookings" class="btn btn-outline-secondary">
                            <i class="bi bi-calendar-check me-1"></i> View All My Bookings
                        </a>

                        <div class="d-flex gap-2">
                            <button onclick="window.print()" class="btn btn-outline-dark">
                                <i class="bi bi-printer me-1"></i> Print Receipt
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-luxe-gold">
                                <i class="bi bi-house me-1"></i> Return Home
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
