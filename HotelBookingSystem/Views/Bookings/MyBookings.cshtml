@model IEnumerable<HotelBookingSystem.Models.Booking>

@{
    ViewData["Title"] = "My Reservations";
    string currentFilter = ViewBag.CurrentFilter as string ?? "all";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="text-warning text-uppercase fw-bold" style="letter-spacing: 0.12em; font-size: 0.85rem;">Guest Portal</span>
            <h1 class="display-6 fw-bold m-0 text-dark">My Reservations</h1>
            <p class="text-muted small m-0">Manage your past, current, and upcoming stays</p>
        </div>

        <a asp-controller="Rooms" asp-action="Index" class="btn btn-luxe-gold">
            <i class="bi bi-plus-circle me-1"></i> Book Another Room
        </a>
    </div>

    <!-- Filter Tabs -->
    <ul class="nav nav-pills mb-4 bg-white p-2 rounded-4 shadow-sm border border-light">
        <li class="nav-item">
            <a class="nav-link @(currentFilter == "all" ? "active bg-dark text-warning" : "text-dark")" asp-action="MyBookings" asp-route-filter="all">
                All Stays (@Model.Count())
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentFilter == "upcoming" ? "active bg-dark text-warning" : "text-dark")" asp-action="MyBookings" asp-route-filter="upcoming">
                Upcoming Stays
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentFilter == "past" ? "active bg-dark text-warning" : "text-dark")" asp-action="MyBookings" asp-route-filter="past">
                Past Stays
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentFilter == "cancelled" ? "active bg-dark text-warning" : "text-dark")" asp-action="MyBookings" asp-route-filter="cancelled">
                Cancelled
            </a>
        </li>
    </ul>

    <!-- Reservations List -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white">
            <div class="py-4">
                <i class="bi bi-calendar-x display-3 text-muted"></i>
                <h3 class="fw-bold mt-3">No Reservations Found</h3>
                <p class="text-muted">You have no reservations under this category.</p>
                <a asp-controller="Rooms" asp-action="Index" class="btn btn-luxe-navy">Explore Available Rooms</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var booking in Model)
            {
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white h-100 anim-fade-up">
                        <div class="row g-0 h-100">
                            <div class="col-sm-5 position-relative">
                                <img src="@(string.IsNullOrEmpty(booking.Room?.ImageUrl) ? "/images/rooms/deluxe.jpg" : booking.Room?.ImageUrl)" 
                                     alt="Room @booking.Room?.RoomNumber" class="w-100 h-100 object-fit-cover" style="min-height: 180px;" 
                                     onerror="this.onerror=null; this.src='/images/rooms/deluxe.jpg';" />
                                
                                <div class="position-absolute top-0 start-0 m-2">
                                    @if (booking.BookingStatus == "Confirmed")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Confirmed
                                        </span>
                                    }
                                    else if (booking.BookingStatus == "CheckedIn")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1">
                                            <i class="bi bi-door-open-fill me-1"></i> Checked-In
                                        </span>
                                    }
                                    else if (booking.BookingStatus == "CheckedOut")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary px-2 py-1">
                                            <i class="bi bi-flag-fill me-1"></i> Completed
                                        </span>
                                    }
                                    else if (booking.BookingStatus == "Cancelled")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i> Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i> Pending
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="col-sm-7 p-3 p-md-4 d-flex flex-direction-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <small class="text-warning text-uppercase fw-bold">#LUXE-@booking.BookingId.ToString("D5")</small>
                                        <small class="text-muted">@booking.BookingDate.ToString("dd MMM yyyy")</small>
                                    </div>

                                    <h4 class="fw-bold text-dark mb-1">Room @booking.Room?.RoomNumber</h4>
                                    <p class="text-muted small mb-2">@booking.Room?.RoomType?.TypeName</p>

                                    <div class="bg-light p-2 rounded-3 small mb-3">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted"><i class="bi bi-box-arrow-in-right text-success me-1"></i> Check-In:</span>
                                            <span class="fw-bold">@booking.CheckInDate.ToString("dd MMM yyyy")</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted"><i class="bi bi-box-arrow-right text-danger me-1"></i> Check-Out:</span>
                                            <span class="fw-bold">@booking.CheckOutDate.ToString("dd MMM yyyy")</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted"><i class="bi bi-people text-info me-1"></i> Guests / Nights:</span>
                                            <span class="fw-semibold">@booking.NumberOfGuests Guest(s) • @((booking.CheckOutDate - booking.CheckInDate).Days) Night(s)</span>
                                        </div>
                                    </div>
                                </div>

                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="text-muted small">Total Cost:</span>
                                        <span class="fs-5 fw-bold text-dark">₹@booking.TotalAmount.ToString("N0")</span>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <a asp-action="Confirmation" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-dark flex-grow-1">
                                            <i class="bi bi-receipt"></i> Voucher
                                        </a>

                                        @if (booking.BookingStatus != "Cancelled" && booking.BookingStatus != "CheckedOut" && booking.CheckInDate >= DateTime.Today)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal-@booking.BookingId">
                                                Cancel
                                            </button>

                                            <!-- Cancel Modal -->
                                            <div class="modal fade" id="cancelModal-@booking.BookingId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content border-0 rounded-4">
                                                        <div class="modal-header bg-danger text-white">
                                                            <h5 class="modal-title fw-bold">Cancel Reservation</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body p-4 text-center">
                                                            <i class="bi bi-exclamation-circle text-danger display-4 mb-3 d-block"></i>
                                                            <h5>Cancel stay for Room @booking.Room?.RoomNumber?</h5>
                                                            <p class="text-muted small">
                                                                Dates: @booking.CheckInDate.ToString("dd MMM yyyy") to @booking.CheckOutDate.ToString("dd MMM yyyy").
                                                                Once cancelled, the room dates will be released.
                                                            </p>
                                                        </div>
                                                        <div class="modal-footer border-0 p-3 bg-light">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep Booking</button>
                                                            <form asp-action="Cancel" asp-route-id="@booking.BookingId" method="post" class="m-0">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-danger">Confirm Cancellation</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
