@model HotelBookingSystem.Models.Booking

@{
    ViewData["Title"] = $"Reservation #LUXE-{Model.BookingId:D5}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <span class="text-warning text-uppercase fw-bold" style="letter-spacing: 0.12em; font-size: 0.85rem;">Reservation Detail</span>
            <h2 class="display-6 fw-bold m-0 text-dark">Stay Details #LUXE-@Model.BookingId.ToString("D5")</h2>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Bookings" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to All Bookings
            </a>
        }
        else
        {
            <a asp-action="MyBookings" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to My Bookings
            </a>
        }
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    <div>
                        <div class="text-muted small">Guest Name:</div>
                        <h4 class="fw-bold text-dark m-0">@Model.User?.FullName</h4>
                        <div class="text-muted small">@Model.User?.Email • @Model.User?.Phone</div>
                    </div>
                    <div>
                        @if (Model.BookingStatus == "Confirmed")
                        {
                            <span class="badge bg-success-subtle text-success border border-success fs-6 px-3 py-2">Confirmed</span>
                        }
                        else if (Model.BookingStatus == "CheckedIn")
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary fs-6 px-3 py-2">Checked-In</span>
                        }
                        else if (Model.BookingStatus == "CheckedOut")
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary fs-6 px-3 py-2">Checked-Out</span>
                        }
                        else if (Model.BookingStatus == "Cancelled")
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger fs-6 px-3 py-2">Cancelled</span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning fs-6 px-3 py-2">Pending</span>
                        }
                    </div>
                </div>

                <hr />

                <div class="row g-3 my-2">
                    <div class="col-sm-6">
                        <small class="text-muted text-uppercase fw-bold">Room</small>
                        <div class="fw-bold fs-5 text-dark">Room @Model.Room?.RoomNumber</div>
                        <div class="text-muted small">@Model.Room?.RoomType?.TypeName</div>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted text-uppercase fw-bold">Floor</small>
                        <div class="fw-bold fs-5 text-dark">Floor @Model.Room?.FloorNumber</div>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted text-uppercase fw-bold">Check-In</small>
                        <div class="fw-bold fs-5 text-dark">@Model.CheckInDate.ToString("dd MMM yyyy")</div>
                        <small class="text-muted">From 2:00 PM</small>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted text-uppercase fw-bold">Check-Out</small>
                        <div class="fw-bold fs-5 text-dark">@Model.CheckOutDate.ToString("dd MMM yyyy")</div>
                        <small class="text-muted">Until 11:00 AM</small>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.SpecialRequest))
                {
                    <div class="p-3 bg-light rounded-3 mt-4">
                        <small class="text-muted text-uppercase fw-bold d-block">Special Requests:</small>
                        <span class="text-dark">@Model.SpecialRequest</span>
                    </div>
                }

                <div class="receipt-total mt-4">
                    <div>
                        <div class="fw-bold text-dark fs-5">Total Paid / Due:</div>
                        <small class="text-muted">@((Model.CheckOutDate - Model.CheckInDate).Days) Night(s) for @Model.NumberOfGuests Guest(s)</small>
                    </div>
                    <div class="fs-3 fw-bold text-warning">
                        ₹@Model.TotalAmount.ToString("N0")
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Confirmation" asp-route-id="@Model.BookingId" class="btn btn-outline-dark">
                        <i class="bi bi-printer me-1"></i> View / Print Voucher
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <img src="@(string.IsNullOrEmpty(Model.Room?.ImageUrl) ? "/images/rooms/deluxe.jpg" : Model.Room?.ImageUrl)" 
                     alt="Room @Model.Room?.RoomNumber" class="w-100" style="height: 220px; object-fit: cover;" 
                     onerror="this.onerror=null; this.src='/images/rooms/deluxe.jpg';" />
                <div class="p-4">
                    <h5 class="fw-bold">Room @Model.Room?.RoomNumber</h5>
                    <p class="text-muted small">@Model.Room?.RoomType?.Description</p>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>Nightly Rate:</span>
                        <span class="fw-bold text-dark">₹@Model.Room?.RoomType?.PricePerNight.ToString("N0")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
