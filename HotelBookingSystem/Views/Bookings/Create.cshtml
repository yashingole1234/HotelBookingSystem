@model HotelBookingSystem.ViewModels.CreateBookingViewModel

@{
    ViewData["Title"] = $"Book Room {Model.RoomNumber}";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Rooms" asp-action="Index">Rooms</a></li>
            <li class="breadcrumb-item"><a asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.RoomId">Room @Model.RoomNumber</a></li>
            <li class="breadcrumb-item active" aria-current="page">Reservation</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Booking Form Column -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
                <div class="p-4 bg-light border-bottom">
                    <span class="text-warning text-uppercase fw-bold" style="letter-spacing: 0.1em; font-size: 0.8rem;">Step 1 of 2</span>
                    <h3 class="fw-bold m-0 text-dark">Confirm Stay Details</h3>
                </div>

                <div class="p-4 p-md-5">
                    <form asp-action="Create" method="post" id="bookingForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="RoomId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="CheckInDate" class="form-label">Check-In Date *</label>
                                <input asp-for="CheckInDate" class="form-control" type="date" 
                                       id="checkInInput"
                                       value="@Model.CheckInDate.ToString("yyyy-MM-dd")" 
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="CheckInDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CheckOutDate" class="form-label">Check-Out Date *</label>
                                <input asp-for="CheckOutDate" class="form-control" type="date" 
                                       id="checkOutInput"
                                       value="@Model.CheckOutDate.ToString("yyyy-MM-dd")" 
                                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="CheckOutDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="NumberOfGuests" class="form-label">Number of Guests *</label>
                                <select asp-for="NumberOfGuests" class="form-select" id="guestCountInput" required>
                                    @for (int i = 1; i <= Model.MaxCapacity; i++)
                                    {
                                        <option value="@i">@i Guest@(i > 1 ? "s" : "")</option>
                                    }
                                </select>
                                <small class="text-muted">Maximum capacity for this room is @Model.MaxCapacity guests.</small>
                                <span asp-validation-for="NumberOfGuests" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="SpecialRequest" class="form-label">Special Requests (Optional)</label>
                                <textarea asp-for="SpecialRequest" class="form-control" rows="3" 
                                          placeholder="e.g. Quiet room, late check-in, dietary restrictions, airport pickup..."></textarea>
                                <span asp-validation-for="SpecialRequest" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Policy Agreement -->
                        <div class="p-3 bg-light rounded-3 mb-4 small text-muted">
                            <i class="bi bi-info-circle text-primary me-1"></i>
                            <strong>Guarantee Policy:</strong> Check-in is at 2:00 PM and check-out is at 11:00 AM. Free cancellation up to 24 hours before your check-in date.
                        </div>

                        <button type="submit" class="btn btn-luxe-gold w-100 py-3 fs-6">
                            <i class="bi bi-shield-lock-fill me-1"></i> Confirm & Complete Reservation
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Room & Live Price Summary Column -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white sticky-top" style="top: 100px;">
                <div class="position-relative" style="height: 200px;">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/rooms/deluxe.jpg" : Model.ImageUrl)" 
                         alt="Room @Model.RoomNumber" class="w-100 h-100 object-fit-cover" 
                         onerror="this.onerror=null; this.src='/images/rooms/deluxe.jpg';" />
                    <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-dark bg-opacity-75 text-white">
                        <div class="fw-bold fs-5">Room @Model.RoomNumber</div>
                        <small class="text-warning text-uppercase">@Model.RoomTypeName</small>
                    </div>
                </div>

                <div class="p-4">
                    <h5 class="fw-bold mb-3">Reservation Summary</h5>

                    <div class="receipt-item">
                        <span class="text-muted">Rate Per Night:</span>
                        <span class="fw-semibold">₹@Model.PricePerNight.ToString("N0")</span>
                    </div>

                    <div class="receipt-item">
                        <span class="text-muted">Total Nights:</span>
                        <span class="fw-semibold" id="summaryNights">@Model.CalculatedNights Night(s)</span>
                    </div>

                    <div class="receipt-item">
                        <span class="text-muted">Room Subtotal:</span>
                        <span class="fw-semibold" id="summarySubtotal">₹@((Model.CalculatedNights * Model.PricePerNight).ToString("N0"))</span>
                    </div>

                    <div class="receipt-item">
                        <span class="text-muted">Taxes & Luxury Cess (12%):</span>
                        <span class="fw-semibold text-muted" id="summaryTax">₹@(((Model.CalculatedNights * Model.PricePerNight) * 0.12m).ToString("N0"))</span>
                    </div>

                    <div class="receipt-total mt-3">
                        <div>
                            <div class="fw-bold text-dark fs-5">Estimated Total:</div>
                            <small class="text-muted">Includes all taxes and resort fees</small>
                        </div>
                        <div class="fs-4 fw-bold text-warning" id="summaryTotal">
                            ₹@(((Model.CalculatedNights * Model.PricePerNight) * 1.12m).ToString("N0"))
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top text-center text-muted small">
                        <i class="bi bi-lock-fill text-success me-1"></i> SSL 256-Bit Encrypted & Verified
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        const pricePerNight = @Model.PricePerNight;
        const checkInInput = document.getElementById('checkInInput');
        const checkOutInput = document.getElementById('checkOutInput');
        const summaryNights = document.getElementById('summaryNights');
        const summarySubtotal = document.getElementById('summarySubtotal');
        const summaryTax = document.getElementById('summaryTax');
        const summaryTotal = document.getElementById('summaryTotal');

        function recalculate() {
            const inDate = new Date(checkInInput.value);
            const outDate = new Date(checkOutInput.value);

            if (outDate > inDate) {
                const diffTime = Math.abs(outDate - inDate);
                const nights = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                const subtotal = nights * pricePerNight;
                const tax = subtotal * 0.12;
                const grandTotal = subtotal + tax;

                summaryNights.textContent = nights + ' Night(s)';
                summarySubtotal.textContent = '₹' + subtotal.toLocaleString('en-IN');
                summaryTax.textContent = '₹' + Math.round(tax).toLocaleString('en-IN');
                summaryTotal.textContent = '₹' + Math.round(grandTotal).toLocaleString('en-IN');
            }
        }

        checkInInput.addEventListener('change', function() {
            // Ensure checkout is after checkin
            const inDate = new Date(this.value);
            inDate.setDate(inDate.getDate() + 1);
            const minOut = inDate.toISOString().split('T')[0];
            checkOutInput.min = minOut;
            if (checkOutInput.value <= this.value) {
                checkOutInput.value = minOut;
            }
            recalculate();
        });

        checkOutInput.addEventListener('change', recalculate);
    </script>
}
