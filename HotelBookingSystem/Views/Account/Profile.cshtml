@model HotelBookingSystem.Models.User

@{
    ViewData["Title"] = "My Account Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white anim-fade-up">
                <!-- Header -->
                <div class="p-4 p-md-5 text-center text-white" style="background: var(--luxe-navy-gradient); border-bottom: 3px solid var(--luxe-gold-400);">
                    <div class="brand-crest mx-auto mb-3" style="width: 70px; height: 70px; font-size: 2.2rem;">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <h2 class="display-6 fw-bold mb-1">@Model.FullName</h2>
                    <p class="text-white-50 m-0">@Model.Email</p>

                    <div class="mt-3">
                        @if (Model.Role == "Admin")
                        {
                            <span class="user-badge badge-admin px-3 py-2 fs-6">
                                <i class="bi bi-shield-lock-fill me-1"></i> Hotel Administrator
                            </span>
                        }
                        else
                        {
                            <span class="user-badge badge-guest px-3 py-2 fs-6">
                                <i class="bi bi-gem me-1"></i> Grand Luxe Club Member
                            </span>
                        }
                    </div>
                </div>

                <!-- Account Information -->
                <div class="p-4 p-md-5">
                    <h5 class="fw-bold text-dark mb-3">Account Details</h5>

                    <div class="list-group list-group-flush mb-4">
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted"><i class="bi bi-person me-2"></i>Full Name</span>
                            <span class="fw-bold text-dark">@Model.FullName</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted"><i class="bi bi-envelope me-2"></i>Email Address</span>
                            <span class="fw-bold text-dark">@Model.Email</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted"><i class="bi bi-telephone me-2"></i>Contact Phone</span>
                            <span class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.Phone) ? "Not Provided" : Model.Phone)</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted"><i class="bi bi-calendar3 me-2"></i>Member Since</span>
                            <span class="fw-bold text-dark">@Model.CreatedAt.ToString("dd MMMM yyyy")</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted"><i class="bi bi-journal-check me-2"></i>Lifetime Stays</span>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning fs-6 px-3 py-1">
                                @Model.Bookings.Count Reservation(s)
                            </span>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top">
                        @if (Model.Role == "Admin")
                        {
                            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-luxe-navy">
                                <i class="bi bi-speedometer2 me-1"></i> Admin Operations
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Bookings" asp-action="MyBookings" class="btn btn-luxe-gold">
                                <i class="bi bi-calendar-heart me-1"></i> View My Reservations
                            </a>
                        }

                        <form asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
