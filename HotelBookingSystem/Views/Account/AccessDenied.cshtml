@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-5 bg-white anim-fade-up">
                <div class="brand-crest mx-auto mb-3" style="width: 70px; height: 70px; font-size: 2.2rem; background: #ef4444;">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h1 class="display-6 fw-bold text-dark mb-2">Access Restricted</h1>
                <p class="lead text-muted mb-4">
                    You do not have administrative credentials to view this protected hotel operational portal.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-house me-1"></i> Return Home
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-luxe-gold px-4">
                        <i class="bi bi-person-badge me-1"></i> Staff Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
