@model HotelBookingSystem.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Create Guest Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="auth-card anim-fade-up">
                <div class="auth-header">
                    <div class="brand-crest mx-auto mb-3" style="width: 50px; height: 50px;">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <h2 class="display-6 fw-bold mb-1">Create Guest Account</h2>
                    <p class="text-white-50 small m-0">Join The Grand Luxe Club for bespoke reservations and benefits</p>
                </div>

                <div class="auth-body">
                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 py-2 small" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="FullName" class="form-label">Full Name *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                                    <input asp-for="FullName" class="form-control border-start-0" placeholder="e.g. Yash Ingole" required />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">Email Address *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                    <input asp-for="Email" class="form-control border-start-0" placeholder="yash@example.com" required />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">Phone Number *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone text-muted"></i></span>
                                    <input asp-for="Phone" class="form-control border-start-0" placeholder="9876543210" required />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label">Create Password *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                                    <input asp-for="Password" class="form-control border-start-0" placeholder="Minimum 6 characters" required />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label">Confirm Password *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-check2-circle text-muted"></i></span>
                                    <input asp-for="ConfirmPassword" class="form-control border-start-0" placeholder="Repeat password" required />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-check my-3">
                            <input class="form-check-input" type="checkbox" id="termsCheck" required checked />
                            <label class="form-check-label small text-muted" for="termsCheck">
                                I agree to the <a href="#" class="text-warning">Terms of Hospitality</a> and <a href="#" class="text-warning">Privacy Policy</a>
                            </label>
                        </div>

                        <button type="submit" class="btn btn-luxe-gold w-100 py-3 mb-3">
                            <i class="bi bi-shield-check me-1"></i> Register My Account
                        </button>

                        <div class="text-center small text-muted">
                            Already a member? 
                            <a asp-action="Login" class="text-warning fw-bold text-decoration-none">Sign In here</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
